GEMINI_API_KEY=

# Server-side Supabase values used by API functions (the anon key is not a service-role key)
SUPABASE_URL=
SUPABASE_ANON_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_KAKAO_JAVASCRIPT_KEY=

# Comma-separated production origins allowed to call server APIs
APP_ORIGIN=https://your-domain.example

# LiveKit Cloud 프로젝트 Settings > Keys에서 발급
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase Edge Function cleanup-live-debate-audio secrets
LIVE_DEBATE_AUDIO_BUDGET_MB=700
LIVE_DEBATE_AUDIO_RETENTION_DAYS=90
LIVE_DEBATE_AUDIO_PROTECTED_COUNT=20
LIVE_DEBATE_AUDIO_HIGH_WATERMARK=0.80
LIVE_DEBATE_AUDIO_TARGET_WATERMARK=0.65
CLEANUP_SECRET=
