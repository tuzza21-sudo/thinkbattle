GEMINI_API_KEY=
OPENAI_API_KEY=

# Server-side Supabase values used by API functions (the anon key is not a service-role key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only: AI moderation decisions. Never prefix this key with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_KAKAO_JAVASCRIPT_KEY=

# Comma-separated production origins allowed to call server APIs
APP_ORIGIN=https://your-domain.example

# LiveKit Cloud 프로젝트 Settings > Keys에서 발급
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase Edge Function cleanup-live-debate-audio secrets
LIVE_DEBATE_AUDIO_BUDGET_MB=700
LIVE_DEBATE_AUDIO_RETENTION_DAYS=90
LIVE_DEBATE_AUDIO_PROTECTED_COUNT=20
LIVE_DEBATE_AUDIO_HIGH_WATERMARK=0.80
LIVE_DEBATE_AUDIO_TARGET_WATERMARK=0.65
CLEANUP_SECRET=

# Voice engines a member can pick in a call (the OpenAI voice speaks without a key).
ELEVENLABS_API_KEY=
TYPECAST_API_KEY=
# Monthly characters a member may have spoken in a premium voice (default 5000, about 15 minutes) and everyone together (0 = no limit).
LOUNGE_ELEVEN_MONTHLY_CHARS=5000
LOUNGE_ELEVEN_TOTAL_MONTHLY_CHARS=0
# JSON that replaces voices without a release: {"eleven":{"jaeseok":"<voice id>","male":"<voice id>"},"typecast":{"female":"<voice id>"}}
LOUNGE_VOICE_IDS=
