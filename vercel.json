{
  "functions": {
    "api/lounge-interaction.ts": { "maxDuration": 60 },
    "api/lounge-images.ts": { "maxDuration": 300 },
    "api/lounge-characters.ts": { "maxDuration": 180 },
    "api/payments.ts": { "maxDuration": 60 },
    "api/lounge-reach-out.ts": { "maxDuration": 120 }
  },
  "crons": [
    { "path": "/api/lounge-images", "schedule": "0 3 * * *" },
    { "path": "/api/lounge-reach-out", "schedule": "0 10 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/gemini/:path*",
      "destination": "/api/gemini/[...path]"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/payments).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/api/payments(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(super-admin|admin|history|battle|simulation|report|institution|argument-library|lounge/spaces|lounge/lounge-)(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(llms|llms-full).txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/((?!api/|assets/).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
